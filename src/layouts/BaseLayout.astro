---
import '../styles/global.css';
import SiteHeader from '../components/islands/SiteHeader';
import Footer from '../components/sections/Footer.astro';
import { practice } from '../data/site';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Pediatric',
  name: practice.name,
  description,
  telephone: practice.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '63-95 Austin St.',
    addressLocality: 'Rego Park',
    addressRegion: 'NY',
    postalCode: '11374',
    addressCountry: 'US',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#9bdcf5" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader client:load />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
