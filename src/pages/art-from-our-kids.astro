---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import PaperEdge from '../components/ui/PaperEdge.astro';
import Contact from '../components/sections/Contact.astro';

// Real drawings from the old site (hot-linked). Run scripts/fetch-old-site-images.sh style copies before launch.
const files = [
  '2278078.jpeg',
  '2191038.png',
  '1949846.jpeg',
  '1949847.jpeg',
  '1949848.jpeg',
  '1949849.jpeg',
  '1949850.jpeg',
  '1949851.jpeg',
  '1949852.jpeg',
  '1949853.jpeg',
  '1949854.jpeg',
  '1949855.jpeg',
  '1949856.jpeg',
  '1949857.jpeg',
  '1949858.jpeg',
  '1949860.jpeg',
  '1949861.jpeg',
  '1949862.jpeg',
  '1949863.jpeg',
  '1949864.jpeg',
  '1949865.jpeg',
];
const base = 'https://sa1s3optim.patientpop.com/assets/images/provider/photos/';
const tape = ['#ffd23f', '#59bfea', '#8f6be0', '#43c37a', '#ff7a66'];
const rot = ['-1deg', '0.8deg', '-0.6deg', '1deg'];
---
<BaseLayout title="Art from our kids | Peds For Kids" description="Drawings and paintings made by our little patients at Peds For Kids in Rego Park, Queens.">
  <PageHero crumb="Art from our kids" title="Art from our kids" lede="Our little artists make our walls bright. Bring a drawing to your next visit and we will hang it up." tone="coral" />

  <section class="section-pad relative bg-paper">
    <PaperEdge variant="scallop" class="text-paper" />
    <div class="container-x relative z-[2]">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {files.map((f, i) => (
          <li>
            <a href={base + f} target="_blank" rel="noopener" class="sheet group relative block p-2.5 transition-transform duration-200 hover:-translate-y-1.5 hover:!rotate-0" style={`--sheet-shade:#f0a595;transform:rotate(${rot[i % rot.length]})`} aria-label={`Open drawing ${i + 1} from our kids`}>
              <span class="absolute -top-3 left-1/2 z-[2] h-6 w-16 -translate-x-1/2 -rotate-3 opacity-85" style={`background:${tape[i % tape.length]}`} aria-hidden="true"></span>
              <img src={base + f} alt={`Drawing ${i + 1} made by a child who visits Peds For Kids`} loading="lazy" class="relative z-[1] aspect-[4/5] w-full rounded-lg bg-white object-contain" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Contact />
</BaseLayout>
