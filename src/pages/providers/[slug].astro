---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperEdge from '../../components/ui/PaperEdge.astro';
import PhotoFrame from '../../components/ui/PhotoFrame.astro';
import Contact from '../../components/sections/Contact.astro';
import { Animal, Butterfly, Cloud, Daisy, Star, Sun } from '../../components/art/Art';
import { practice } from '../../data/site';
import { team } from '../../data/team';
import { photos } from '../../data/images';
import { abs, clinicId } from '../../data/seo';

export function getStaticPaths() {
  return team.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const others = team.filter((o) => o.slug !== p.slug);
const bg: Record<string, string> = { sun: '#ffe88f', coral: '#ffd6cc', sky: '#bfe8f8', meadow: '#cdefd7', grape: '#e4dbfa' };
const shade: Record<string, string> = { sun: '#e3c453', coral: '#f2a999', sky: '#8fcbe6', meadow: '#7fcf9f', grape: '#bda9ef' };
const url = `/providers/${p.slug}/`;
const pickDesc = (c: string[]) => c.find((x) => x.length >= 130 && x.length <= 155) ?? c.filter((x) => x.length <= 155).sort((a, b) => b.length - a.length)[0] ?? c[c.length - 1];
const description = pickDesc([
  `Meet ${p.name}, ${p.role.toLowerCase()} at Peds For Kids in Rego Park, Queens. Call 718-268-9100 to book a visit.`,
  `Meet ${p.name} at Peds For Kids in Rego Park, Queens, caring for babies, kids and teens. Call 718-268-9100 to book a visit.`,
  `Meet ${p.name} at Peds For Kids in Rego Park, Queens. Care for babies, kids and teens. Call 718-268-9100.`,
]);
const photo = photos[p.photoSlot]?.src;
const person = {
  '@type': 'Person',
  '@id': abs(`${url}#person`),
  name: p.name,
  url: abs(url),
  jobTitle: p.role,
  description: p.lede,
  worksFor: { '@id': clinicId },
  ...(photo ? { image: abs(photo) } : {}),
  ...(p.details.find((d) => d.title === 'Languages') ? { knowsLanguage: p.details.find((d) => d.title === 'Languages')!.items } : {}),
};
---
<BaseLayout title={`${p.name} | Peds For Kids`} description={description} schema={[person]} crumbs={[{ name: 'Providers', path: '/providers/' }, { name: p.name, path: url }]}>
  <!-- Intro -->
  <section class="relative overflow-hidden bg-sky-soft pb-24 pt-36 md:pb-32 md:pt-44">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="bg-layer bg-skyfade"></div>
      <div class="bg-layer bg-doodle-sky"></div>
      <Sun className="bob absolute right-[5%] top-28 hidden w-24 md:block" />
      <Cloud className="drift absolute left-[3%] top-36 hidden w-32 md:block" />
      <Butterfly className="bob absolute left-[46%] bottom-20 hidden w-12 md:block" color="#8f6be0" />
    </div>
    <div class="container-x relative z-[2] grid items-center gap-12 md:grid-cols-[1.1fr_minmax(0,20rem)] lg:gap-20">
      <div>
        <p class="font-display text-lg font-bold text-ink-soft"><a href="/about/#providers" class="hover:underline">Our providers</a> / {p.short}</p>
        <h1 class="h-display mt-2">{p.name}</h1>
        <p class="mt-2 font-display text-xl font-bold">{p.role}</p>
        <p class="lede mt-4 max-w-[56ch]">{p.lede}</p>
        <ul class="mt-6 flex flex-wrap gap-2.5" aria-label="Highlights">
          {p.facts.map((f, i) => (
            <li class="tag" style={`--tag-shade:${['#f0c200', '#ff9d8e', '#7fcf9f', '#bda9ef'][i % 4]}`}>{f}</li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={practice.phoneHref} class="btn">Call {practice.phone}</a>
        </div>
      </div>
      <div class="group relative mx-auto w-full max-w-xs">
        <span class="absolute -left-5 -top-4 h-full w-full -rotate-3 rounded-[45%_55%_40%_60%/50%_45%_55%_50%] bg-sun-soft" aria-hidden="true"></span>
        <PhotoFrame eager slot={p.photoSlot} shape="arch" tape="#ffd23f" class="relative aspect-[4/5] w-full transition-transform duration-300 group-hover:-rotate-1 group-hover:scale-[1.02] motion-reduce:transition-none" pos="center 25%">
          <div class="relative grid aspect-[4/5] w-full place-items-end overflow-hidden rounded-[45%_55%_8%_8%/30%_30%_8%_8%]" style={`background:${bg[p.color]};box-shadow:0 7px 0 ${shade[p.color]}`}>
            <Animal name={p.animal} className="w-[85%]" />
          </div>
        </PhotoFrame>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section-pad relative overflow-hidden bg-paper">
    <PaperEdge variant="cloud" class="text-paper" />
    <div class="absolute inset-0" aria-hidden="true">
      <div class="bg-layer" style="background:radial-gradient(40% 50% at 90% 20%, rgba(255,232,143,0.5), transparent 70%), radial-gradient(40% 50% at 5% 90%, rgba(205,239,215,0.7), transparent 70%)"></div>
      <Star className="bob absolute right-[8%] top-20 hidden w-9 md:block" color="#ffd23f" />
      <Daisy className="absolute bottom-4 left-[10%] hidden w-9 md:block" />
    </div>
    <div class="container-x relative z-[2] grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start lg:gap-14">
      <div>
        <h2 class="h-section">About {p.short}</h2>
        <div class="mt-5 space-y-4 text-lg">
          {p.about.map((t) => <p class="max-w-[60ch]">{t}</p>)}
        </div>
      </div>
      <ul class="grid gap-5">
        {p.details.map((d) => (
          <li class="sheet p-6 transition-transform duration-200 hover:-translate-y-1" style={`--sheet:${bg[d.color]};--sheet-shade:${shade[d.color]};`}>
            <h3 class="relative z-[1] text-xl">{d.title}</h3>
            <ul class="relative z-[1] mt-3 space-y-1.5">
              {d.items.map((it) => (
                <li class="flex gap-2.5"><span class="mt-2 size-2 shrink-0 rounded-full bg-ink/70" aria-hidden="true"></span><span>{it}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Rest of the team -->
  <section class="section-pad relative bg-meadow-soft">
    <PaperEdge variant="scallop" class="text-meadow-soft" />
    <div class="container-x relative z-[2]">
      <h2 class="h-section">Meet the rest of the team</h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <li class="flex">
          <a href="/dr-daniela/" class="sheet group flex w-full flex-col p-7 transition-transform duration-200 hover:-translate-y-1.5" style="--sheet:#ffe88f;--sheet-shade:#e3c453;">
            <h3 class="relative z-[1] text-2xl">Dr. Daniela Atanassova-Lineva</h3>
            <p class="relative z-[1] mt-1 font-bold text-ink-soft">Pediatrician and founder</p>
            <span class="relative z-[1] mt-auto pt-5 font-display text-lg font-bold underline decoration-coral decoration-[3px] underline-offset-4">Meet Dr. Daniela</span>
          </a>
        </li>
        {others.map((o) => (
          <li class="flex">
            <a href={`/providers/${o.slug}/`} class="sheet group flex w-full flex-col p-7 transition-transform duration-200 hover:-translate-y-1.5" style="--sheet:#fffdf7;--sheet-shade:#7fcf9f;">
              <h3 class="relative z-[1] text-2xl">{o.name}</h3>
              <p class="relative z-[1] mt-1 font-bold text-ink-soft">{o.role}</p>
              <span class="relative z-[1] mt-auto pt-5 font-display text-lg font-bold underline decoration-coral decoration-[3px] underline-offset-4">Meet {o.short}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Contact />
</BaseLayout>
