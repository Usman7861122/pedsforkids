---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PaperEdge from '../../components/ui/PaperEdge.astro';
import PhotoFrame from '../../components/ui/PhotoFrame.astro';
import Contact from '../../components/sections/Contact.astro';
import { Animal, Butterfly, Daisy, Tree } from '../../components/art/Art';
import { practice, providers } from '../../data/site';
import { team } from '../../data/team';

// Dr. Daniela first, then the nurse practitioners.
const people = providers.map((p, i) => ({
  name: p.name,
  short: p.short,
  role: p.role,
  text: p.text,
  animal: p.animal,
  color: p.color,
  slot: `provider${i}`,
  href: i === 0 ? '/dr-daniela' : `/providers/${team[i - 1].slug}`,
}));
const bg: Record<string, string> = { sun: '#ffe88f', coral: '#ffd6cc', sky: '#bfe8f8', meadow: '#cdefd7' };
const shade: Record<string, string> = { sun: '#e3c453', coral: '#f2a999', sky: '#8fcbe6', meadow: '#7fcf9f' };
---
<BaseLayout title="Our providers | Peds For Kids" description="Meet the providers at Peds For Kids in Rego Park, Queens: Dr. Daniela Atanassova-Lineva and our board-certified nurse practitioners.">
  <PageHero crumb="Providers" title="Meet our providers" lede="Everyone on our team is board certified and loves working with kids. Pick who you would like to see when you book." tone="meadow">
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={practice.bookUrl} class="btn">Book a visit</a>
      <a href={practice.phoneHref} class="btn btn-paper">Call {practice.phone}</a>
    </div>
  </PageHero>

  <section class="section-pad relative overflow-hidden bg-paper">
    <PaperEdge variant="scallop" class="text-paper" />
    <div class="absolute inset-0" aria-hidden="true">
      <div class="bg-layer bg-dots" style="opacity:0.35"></div>
      <Butterfly className="bob absolute right-[8%] top-20 hidden w-12 md:block" />
      <Daisy className="absolute bottom-6 left-[8%] hidden w-9 md:block" />
      <Tree className="absolute bottom-0 right-[4%] hidden w-14 lg:block" />
    </div>
    <div class="container-x relative z-[2]">
      <ul class="grid gap-x-6 gap-y-16 pt-8 sm:grid-cols-2 lg:grid-cols-3">
        {people.map((p) => (
          <li class="flex">
            <article class="sheet group relative flex w-full flex-col px-6 pb-7 pt-32 text-center transition-transform duration-200 hover:-translate-y-1.5" style={`--sheet:#fffdf7;--sheet-shade:${shade[p.color]};`}>
              <div class="absolute inset-x-6 -top-8 z-[2] mx-auto h-36 w-36 transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105">
                <PhotoFrame slot={p.slot} shape="round" class="h-full w-full">
                  <div class="grid h-full w-full place-items-end overflow-hidden rounded-full" style={`background:${bg[p.color]};box-shadow:0 5px 0 ${shade[p.color]}`}>
                    <Animal name={p.animal} stetho={p.animal === 'owl'} className="w-[92%]" />
                  </div>
                </PhotoFrame>
              </div>
              <h2 class="relative z-[1] text-[1.4rem]">{p.name}</h2>
              <p class="relative z-[1] mt-1 font-bold text-ink-soft">{p.role}</p>
              <p class="relative z-[1] mt-3">{p.text}</p>
              <div class="relative z-[1] mt-auto flex flex-col items-center gap-3 pt-6">
                <a href={p.href} class="btn btn-meadow !px-5 !py-3 !text-base">Meet {p.short}</a>
                <a href={practice.bookUrl} class="font-bold underline decoration-coral decoration-[3px] underline-offset-4">Book with {p.short}</a>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <p class="mt-14 text-ink-soft">Not sure who to see? Call us at <a href={practice.phoneHref} class="font-bold underline">{practice.phone}</a> and we will help you choose.</p>
    </div>
  </section>

  <Contact />
</BaseLayout>
