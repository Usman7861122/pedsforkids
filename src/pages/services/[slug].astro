---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { photos } from '../../data/images';
import { abs, websiteId } from '../../data/seo';
import PaperEdge from '../../components/ui/PaperEdge.astro';
import PhotoFrame from '../../components/ui/PhotoFrame.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import Contact from '../../components/sections/Contact.astro';
import { Butterfly, Cloud, Daisy, Star, Sun } from '../../components/art/Art';
import { practice, services, serviceAreas } from '../../data/site';
import { serviceTopics } from '../../data/serviceTopics';

export function getStaticPaths() {
  return serviceTopics.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const related = services.filter((s) => s.slug !== t.slug);
const photoSlot = (s: { slug: string }) => `svc-${s.slug}`;
const sectionBg = ['bg-paper', 'bg-sun-soft', 'bg-meadow-soft', 'bg-grape-soft', 'bg-sky-soft'];
const edgeText = ['text-paper', 'text-sun-soft', 'text-meadow-soft', 'text-grape-soft', 'text-sky-soft'];
const tones: Record<string, { sheet: string; shade: string }> = {
  sky: { sheet: '#bfe8f8', shade: '#8fcbe6' },
  coral: { sheet: '#ffd6cc', shade: '#f2a999' },
  meadow: { sheet: '#cdefd7', shade: '#7fcf9f' },
  sun: { sheet: '#ffe88f', shade: '#e3c453' },
  grape: { sheet: '#e4dbfa', shade: '#bda9ef' },
};
const sectionKey = ['paper', 'sun', 'meadow', 'grape', 'sky'];
// Card colors for a section, leaving out the section's own color so cards never blend in.
const pal = (i: number, j: number) => {
  const keys = Object.keys(tones).filter((k) => k !== sectionKey[i % 5]);
  return tones[keys[j % keys.length]];
};
const tilt = ['-1.2deg', '0.8deg', '-0.6deg', '1.2deg'];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const url = `/services/${t.slug}/`;
const shot = photos[t.photo];
const webpage = { '@type': 'MedicalWebPage', '@id': abs(`${url}#webpage`), url: abs(url), name: `${t.title} in Rego Park, Queens`, description: t.description, isPartOf: { '@id': websiteId }, inLanguage: 'en-US' };
---
<BaseLayout
  title={`${t.title} in Rego Park, Queens | Peds For Kids`}
  description={t.description}
  image={shot?.src?.startsWith('/') ? shot.src : undefined}
  imageAlt={shot?.alt}
  schema={[webpage]}
  crumbs={[{ name: 'Services', path: '/services/' }, { name: t.title, path: url }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Intro -->
  <section class="relative overflow-hidden bg-sky-soft pb-24 pt-36 md:pb-32 md:pt-44">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="bg-layer bg-skyfade"></div>
      <div class="bg-layer bg-doodle-sky"></div>
      <Sun className="bob absolute right-[4%] top-28 hidden w-20 md:block" />
      <Cloud className="drift absolute left-[3%] top-36 hidden w-32 md:block" />
      <Butterfly className="bob absolute left-[48%] bottom-16 hidden w-12 md:block" color="#8f6be0" />
    </div>
    <div class="container-x relative z-[2] grid items-center gap-12 md:grid-cols-[1.1fr_minmax(0,24rem)] lg:gap-20">
      <div>
        <nav aria-label="Breadcrumb" class="font-display text-base font-bold text-ink-soft">
          <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> <a href="/services" class="hover:underline">Services</a>
        </nav>
        <h1 class="h-display mt-3">{t.h1}</h1>
        <p class="lede mt-5 max-w-[56ch]">{t.lede}</p>
        <ul class="mt-6 flex flex-wrap gap-2.5" aria-label="Highlights">
          {t.tags.map((g, i) => (
            <li class="tag" style={`--tag-shade:${['#f0c200', '#ff9d8e', '#7fcf9f', '#bda9ef'][i % 4]}`}>{g}</li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={practice.bookUrl} class="btn">Book a visit</a>
          <a href={practice.phoneHref} class="btn btn-paper">Call {practice.phone}</a>
        </div>
      </div>
      <div class="group relative mx-auto w-full max-w-sm">
        <span class="absolute -left-5 -top-4 h-full w-full -rotate-3 rounded-[45%_55%_40%_60%/50%_45%_55%_50%] bg-sun-soft" aria-hidden="true"></span>
        <PhotoFrame slot={t.photo} shape="arch" tape="#ffd23f" class="relative aspect-[4/5] w-full transition-transform duration-300 group-hover:-rotate-1 group-hover:scale-[1.02] motion-reduce:transition-none" pos="center 30%" />
      </div>
    </div>
  </section>

  <!-- Content blocks -->
  {t.blocks.map((b, i) => (
    <section class={`section-pad relative overflow-hidden ${sectionBg[i % 5]}`}>
      <PaperEdge variant={i % 2 ? 'scallop' : 'cloud'} class={edgeText[i % 5]} />
      <div class="absolute inset-0" aria-hidden="true">
        {i % 2 === 0 ? <Star className="bob absolute right-[8%] top-20 hidden w-9 md:block" color="#ffd23f" /> : <Daisy className="absolute bottom-4 left-[9%] hidden w-9 md:block" />}
      </div>
      <div class="container-x relative z-[2]">
        <div class="max-w-2xl">
          <h2 class="h-section">{b.title}</h2>
          {b.text && <p class="lede mt-4 !text-ink">{b.text}</p>}
        </div>

        {b.type === 'cards' && (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {b.items.map((c, j) => (
              <li class="flex">
                <article class="sheet flex w-full flex-col p-7 transition-transform duration-200 hover:-translate-y-1.5" style={`--sheet:${pal(i, j).sheet};--sheet-shade:${pal(i, j).shade};`}>
                  <h3 class="relative z-[1] text-2xl">{c.title}</h3>
                  <p class="relative z-[1] mt-2 text-ink-soft">{c.text}</p>
                </article>
              </li>
            ))}
          </ul>
        )}

        {b.type === 'list' && (
          <ul class="mt-10 grid gap-3 sm:grid-cols-2">
            {b.items.map((it) => (
              <li class="sheet flex items-center gap-3 px-5 py-4 transition-transform duration-200 hover:-translate-y-1" style="--sheet:#fffdf7;--sheet-shade:#bfd9e6;">
                <span class="relative z-[1] grid size-7 shrink-0 place-items-center rounded-full bg-sun text-sm font-extrabold" aria-hidden="true">✓</span>
                <span class="relative z-[1] font-medium">{it}</span>
              </li>
            ))}
          </ul>
        )}

        {b.type === 'prices' && (
          <>
            <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {b.items.map((p, j) => (
                <li class="flex">
                  <article class="sheet flex w-full flex-col p-7 transition-transform duration-200 hover:-translate-y-1.5" style={`--sheet:${pal(i, j).sheet};--sheet-shade:${pal(i, j).shade};`}>
                    <p class="relative z-[1] font-display text-4xl font-extrabold">{p.price}</p>
                    <h3 class="relative z-[1] mt-1 text-2xl">{p.name}</h3>
                    <p class="relative z-[1] mt-2">{p.text}</p>
                    <p class="relative z-[1] mt-3 text-sm text-ink-soft">{p.mix}</p>
                  </article>
                </li>
              ))}
            </ul>
            {b.note && <p class="mt-8 max-w-[64ch] text-ink-soft">{b.note}</p>}
          </>
        )}
      </div>
    </section>
  ))}

  <!-- Questions -->
  <section class="section-pad relative bg-paper">
    <PaperEdge variant="cloud" class="text-paper" />
    <div class="container-x relative z-[2] max-w-3xl">
      <h2 class="h-section">Questions parents ask</h2>
      <div class="mt-8 space-y-3">
        {t.faqs.map((f) => (
          <details class="sheet group px-6 py-4" style="--sheet:#fffdf7;--sheet-shade:#bfd9e6;">
            <summary class="relative z-[1] flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
              {f.q}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-sun transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="relative z-[1] mt-3 text-ink-soft">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-ink-soft">For a medical emergency, call 911. Families come to us from {serviceAreas.join(', ')} and nearby.</p>
    </div>
  </section>

  <!-- Other services -->
  <section class="section-pad relative bg-sun-soft">
    <PaperEdge variant="scallop" class="text-sun-soft" />
    <div class="container-x relative z-[2]">
      <h2 class="h-section">More ways we can help</h2>
      <ul class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
        {related.slice(0, 4).map((s, i) => (
          <li>
            <ServiceCard href={`/services/${s.slug}`} title={s.title} text={s.text} glyph={s.glyph} color={s.color} slot={photoSlot(s)} tilt={tilt[i % 4]} />
          </li>
        ))}
      </ul>
      <p class="mt-8"><a href="/services" class="font-display text-lg font-bold underline decoration-coral decoration-[3px] underline-offset-4">See all services</a></p>
    </div>
  </section>

  <Contact />
</BaseLayout>
