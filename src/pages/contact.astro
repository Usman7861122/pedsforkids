---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Contact from '../components/sections/Contact.astro';
import { practice } from '../data/site';
---
<BaseLayout title="Contact Peds For Kids: Rego Park Pediatrician, NY" description="Contact Peds For Kids in Rego Park, Queens. Call 718-268-9100, get directions to 63-95 Austin St, see office hours or book a visit online today.">
  <PageHero crumb="Contact" title="Contact us" lede="Call, book online or stop by. We are at 63-95 Austin St. in Rego Park." tone="coral">
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={practice.phoneHref} class="btn">Call {practice.phone}</a>
      <a href={practice.mapsUrl} target="_blank" rel="noopener" class="btn btn-paper">Get directions</a>
    </div>
  </PageHero>
  <Contact />
</BaseLayout>
