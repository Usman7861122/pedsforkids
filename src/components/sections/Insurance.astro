---
import PaperEdge from '../ui/PaperEdge.astro';
import { Cloud, Plane, Star } from '../art/Art';
import { insurancesFeatured, insurancesMore, insuranceLogos, practice } from '../../data/site';

const withLogo = new Set(insuranceLogos.map((l) => l.name));
const rest = Array.from(new Set([...insurancesFeatured, ...insurancesMore])).filter((n) => !withLogo.has(n)).sort((a, b) => a.localeCompare(b));
const shades = ['#f0c200', '#ff9d8e', '#7fcf9f', '#9bd3ee', '#c9b8f2'];
---
<section id="insurance" class="section-pad relative bg-paper">
  <PaperEdge variant="wave" class="text-paper" />
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <img src="/images/insurance-kids.jpg" alt="" loading="lazy" class="absolute inset-x-0 top-0 h-[34rem] w-full object-cover object-[50%_30%] opacity-[0.22] [mask-image:linear-gradient(to_bottom,black_0%,black_25%,transparent_75%)] md:h-[40rem]" />
    <div class="bg-layer bg-grid"></div>
    <Cloud className="drift absolute -right-10 top-24 hidden w-56 md:block" />
    <Plane className="bob absolute right-[12%] top-[38%] hidden w-20 md:block" color="#59bfea" light="#8fd3f1" dark="#2c8fc2" style={{ ['--r' as string]: '-6deg' }} />
    <Star className="bob absolute left-[4%] bottom-16 hidden w-10 md:block" color="#ffd23f" />
  </div>
  <div class="container-x relative z-[2]">
    <div class="max-w-2xl">
      <h2 class="h-section">Insurance we accept</h2>
      <p class="lede mt-4">Type your plan to see if we take it. No insurance? Self-pay families are welcome too.</p>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4">
      {insuranceLogos.map((l) => (
        <li class="flex h-24 items-center justify-center rounded-2xl bg-paper p-4 shadow-[0_5px_0_#bfd9e6] ring-1 ring-ink/5 md:h-28">
          <img src={l.logo} alt={l.name} loading="lazy" class="max-h-full max-w-full object-contain" />
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
      <button type="button" id="plans-open" class="btn btn-sun">View full list of plans ({rest.length} more)</button>
      <p class="text-sm text-ink-soft">Coverage can change. Please call <a href={practice.phoneHref} class="font-bold underline decoration-coral decoration-[3px] underline-offset-4">{practice.phone}</a> to confirm your plan.</p>
    </div>
  </div>

  <dialog id="plans-box" aria-labelledby="plans-title" class="m-auto max-h-[90vh] w-[min(92vw,44rem)] rounded-3xl bg-paper p-6 backdrop:bg-ink/70 md:p-8">
    <h3 id="plans-title" class="text-2xl">More plans we accept</h3>
    <ul class="mt-5 flex max-h-[55vh] flex-wrap gap-2.5 overflow-y-auto pr-1">
      {rest.map((n, i) => <li class="tag" style={`--tag-shade:${shades[i % shades.length]}`}>{n}</li>)}
    </ul>
    <p class="mt-5 text-sm text-ink-soft">Not on the list? Call us at <a href={practice.phoneHref} class="font-bold underline decoration-coral decoration-[3px] underline-offset-4">{practice.phone}</a> and we will check your plan.</p>
    <button type="button" id="plans-close" class="btn btn-paper mt-6">Close</button>
  </dialog>
</section>

<script>
  const box = document.getElementById('plans-box') as HTMLDialogElement | null;
  document.getElementById('plans-open')?.addEventListener('click', () => box?.showModal());
  document.getElementById('plans-close')?.addEventListener('click', () => box?.close());
  box?.addEventListener('click', (e) => { if (e.target === box) box.close(); });
</script>
