---
import PaperEdge from '../ui/PaperEdge.astro';
import { Cloud, Plane, Star } from '../art/Art';
import { insuranceList, insuranceLogos, practice } from '../../data/site';

const logoFor = new Map(insuranceLogos.map((l) => [l.name, l.logo]));
const plans = insuranceList.map((name) => ({ name, logo: logoFor.get(name) }));
const dot = ['#f0c200', '#ff9d8e', '#7fcf9f', '#9bd3ee', '#c9b8f2'];
---
<section id="insurance" class="section-pad relative bg-paper">
  <PaperEdge variant="wave" class="text-paper" />
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <img src="/images/insurance-kids.jpg" alt="" loading="lazy" class="absolute inset-x-0 top-0 h-[34rem] w-full object-cover object-[50%_30%] opacity-[0.22] [mask-image:linear-gradient(to_bottom,black_0%,black_25%,transparent_75%)] md:h-[40rem]" />
    <div class="bg-layer bg-grid"></div>
    <Cloud className="drift absolute -right-10 top-24 hidden w-56 md:block" />
    <Plane className="bob absolute right-[12%] top-[38%] hidden w-20 md:block" color="#59bfea" light="#8fd3f1" dark="#2c8fc2" style={{ ['--r' as string]: '-6deg' }} />
    <Star className="bob absolute left-[4%] bottom-16 hidden w-10 md:block" color="#ffd23f" />
  </div>
  <div class="container-x relative z-[2]">
    <div class="max-w-2xl">
      <h2 class="h-section">Insurance we accept</h2>
      <p class="lede mt-4">We are in network with these plans. Find yours below.</p>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4 lg:grid-cols-5">
      {plans.map((p, i) => (
        <li class="flex h-24 items-center justify-center rounded-2xl bg-paper p-4 text-center shadow-[0_5px_0_#bfd9e6] ring-1 ring-ink/5 transition-transform duration-200 hover:-translate-y-1 md:h-28">
          {p.logo ? (
            <img src={p.logo} alt={p.name} loading="lazy" class="max-h-full max-w-full object-contain" />
          ) : (
            <span class="flex items-center gap-2.5 text-left">
              <span class="size-3 shrink-0 rounded-full" style={`background:${dot[i % dot.length]}`} aria-hidden="true"></span>
              <span class="font-display text-[0.95rem] font-bold leading-tight">{p.name}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-10 max-w-[60ch] text-sm text-ink-soft">No insurance? Self-pay families are welcome too. Coverage can change, so please call <a href={practice.phoneHref} class="font-bold underline decoration-coral decoration-[3px] underline-offset-4">{practice.phone}</a> to confirm your plan.</p>
  </div>
</section>

<script>
  const box = document.getElementById('plans-box') as HTMLDialogElement | null;
  document.getElementById('plans-open')?.addEventListener('click', () => box?.showModal());
  document.getElementById('plans-close')?.addEventListener('click', () => box?.close());
  box?.addEventListener('click', (e) => { if (e.target === box) box.close(); });
</script>
