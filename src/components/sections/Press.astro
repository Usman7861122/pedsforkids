---
import PaperEdge from '../ui/PaperEdge.astro';
import { Bunting, Cloud, Owl, Star } from '../art/Art';
import PhotoFrame from '../ui/PhotoFrame.astro';
import { press } from '../../data/site';
---
<section id="press" class="section-pad relative bg-grape-soft">
  <PaperEdge variant="wave" class="text-grape-soft" />
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="bg-layer bg-dots"></div>
    <div class="bg-layer bg-confetti"></div>
    <Bunting className="absolute inset-x-0 top-0 h-16 w-full md:h-24" />
  </div>
  <div class="container-x relative z-[2]">
    <h2 class="h-section max-w-2xl">In the news</h2>

    <div class="mt-10 grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <!-- TODO: swap for a real photo of Dr. Daniela -->
      <PhotoFrame slot="doctor" shape="arch" tape="#ffd23f" class="mx-auto aspect-[4/5] w-full max-w-sm -rotate-2">
      <div class="sheet relative mx-auto aspect-[4/5] w-full max-w-sm -rotate-2 overflow-hidden" style="--sheet:#fff0b8;--sheet-shade:#e3c453;">
        <Cloud className="drift absolute left-3 top-8 w-28" />
        <Star className="bob absolute right-8 top-10 w-10" color="#ff7a66" />
        <Star className="bob absolute right-20 top-24 w-6" color="#8f6be0" />
        <div class="absolute inset-x-0 bottom-0 h-1/5 rounded-t-[3rem] bg-meadow"></div>
        <Owl stetho className="absolute bottom-3 left-1/2 w-[70%] -translate-x-1/2" />
      </div>
      </PhotoFrame>

      <div>
        <article class="sheet p-7 md:p-9" style="--sheet:#fffdf7;--sheet-shade:#bda9ef;">
          <div class="relative z-[1]">
            <p class="font-bold text-coral-deep">{press.main.kicker}</p>
            <h3 class="mt-2 text-3xl md:text-4xl">{press.main.title}</h3>
            <p class="mt-4 max-w-[58ch]">{press.main.text}</p>
            <a href={press.main.href} class="btn btn-sun mt-6">Read the full story</a>
          </div>
        </article>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {press.more.map((m) => (
            <li>
              <a href={m.href} class="sheet group block p-5 transition-transform hover:-translate-y-1" style="--sheet:#fffdf7;--sheet-shade:#bda9ef;">
                <span class="relative z-[1] block font-display text-xl font-bold leading-tight">{m.title}</span>
                <span class="relative z-[1] mt-1 block text-sm text-ink-soft">{m.source}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-8 font-display text-lg font-bold">As seen on</p>
        <ul class="mt-3 flex flex-wrap items-center gap-3">
          {press.seenOn.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.name} story about Dr. Daniela`} class="flex h-16 w-32 items-center justify-center rounded-2xl bg-paper px-4 shadow-[0_5px_0_#c9b8f2] transition-transform hover:-translate-y-0.5 md:h-[4.5rem] md:w-36">
                <img src={s.logo} alt={s.name} loading="lazy" class="max-h-full max-w-full object-contain" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
