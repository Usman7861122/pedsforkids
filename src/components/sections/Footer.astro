---
import Pic from '../ui/Pic.astro';
import { Daisy, Hills } from '../art/Art';
import { practice } from '../../data/site';

const explore = [
  { label: 'About us', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Providers', href: '/providers/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Our office', href: '/our-office/' },
  { label: 'Patient forms', href: '/patient-forms/' },
];
const more = [
  { label: 'Reviews', href: '/testimonials/' },
  { label: 'Health blog', href: '/blog/' },
  { label: "Dr. Daniela's book", href: '/book-by-dr-daniela/' },
  { label: 'Observership program', href: '/observership/' },
  { label: 'Art from our kids', href: '/art-from-our-kids/' },
  { label: 'Awards and press', href: '/press/' },
];
const legal = [
  { label: 'Privacy policy', href: '/privacy-policy/' },
  { label: 'Terms and conditions', href: '/terms/' },
  { label: 'Accessibility notice', href: '/accessibility/' },
];
---
<footer class="relative bg-ink text-paper">
  <div class="pointer-events-none absolute inset-x-0 top-0 -translate-y-[calc(100%-2px)]" aria-hidden="true">
    <Hills className="block h-40 w-full md:h-52" colors={['#7fdc9d', '#43c37a', '#2a2250']} />
    <Daisy className="absolute bottom-[38%] left-[8%] w-10" />
    <Daisy className="absolute bottom-[30%] left-[34%] w-8" />
    <Daisy className="absolute bottom-[42%] right-[22%] w-10" />
    <Daisy className="absolute bottom-[28%] right-[6%] w-8" />
  </div>

  <div class="container-x grid gap-10 pb-10 pt-6 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5" aria-label="Peds For Kids, home">
        <span class="rounded-2xl bg-paper p-2"><Pic sizes="96px" src="/images/logo.png" alt="Peds for Kids" width="121" height="120" class="h-24 w-auto" /></span>
      </a>
      <p class="mt-4 max-w-[26ch] font-display text-xl font-bold leading-snug text-sun">{practice.slogan}</p>
      <p class="mt-2 max-w-[30ch] text-paper/80">{practice.tagline}.</p>
      <ul class="mt-5 flex gap-3">
        {practice.social.map((s) => (
          <li><a href={s.href} class="tag !bg-paper text-ink" style="--tag-shade:#8b84b8" target="_blank" rel="noopener">{s.name}</a></li>
        ))}
      </ul>
    </div>

    <nav aria-label="Explore">
      <h2 class="font-display text-xl">Explore</h2>
      <ul class="mt-2">
        {explore.map((l) => <li><a href={l.href} class="inline-flex min-h-12 items-center text-paper/85 hover:text-sun">{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="More">
      <h2 class="font-display text-xl">More to explore</h2>
      <ul class="mt-2">
        {more.map((l) => <li><a href={l.href} class="inline-flex min-h-12 items-center text-paper/85 hover:text-sun">{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-xl">Visit us</h2>
      <address class="mt-3 not-italic text-paper/85">
        {practice.address.map((l) => <span class="block">{l}</span>)}
        <a href={practice.phoneHref} class="mt-2 block font-bold text-sun">{practice.phone}</a>
      </address>
      <a href={practice.bookUrl} class="btn btn-sun mt-5 !px-5 !py-3 !text-base">Book a visit</a>
    </div>
  </div>

  <div class="container-x border-t-2 border-dashed border-paper/20 py-6 text-sm text-paper/70">
    <nav aria-label="Legal">
      <ul class="flex flex-wrap gap-x-6">
        {legal.map((l) => <li><a href={l.href} class="inline-flex min-h-12 items-center text-paper/85 hover:text-sun">{l.label}</a></li>)}
      </ul>
    </nav>
    <p class="mt-2">For a medical emergency, call 911.</p>
    <p class="mt-1">© 2026 {practice.legalName}. All rights reserved.</p>
  </div>
</footer>
