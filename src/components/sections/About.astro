---
import PaperEdge from '../ui/PaperEdge.astro';
import { Cloud, Owl, Sun } from '../art/Art';
import { practice } from '../../data/site';

const facts = ['Speaks five languages', 'Top Pediatrician of the Year 2022', 'Insured or self-pay', 'New patients welcome'];
const tests = ['Rapid strep and flu tests', 'Lung function tests', 'EKG', 'Blood work', 'Genetic testing'];
---
<section id="about" class="section-pad relative bg-paper">
  <PaperEdge variant="cloud" class="text-paper" />
  <div class="container-x grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <!-- Illustration -->
    <div class="relative mx-auto w-full max-w-md">
      <div class="sheet aspect-[4/5] overflow-hidden" style="--sheet:#bfe8f8;--sheet-shade:#8fcbe6;">
        <Sun className="absolute -right-8 -top-8 w-40" />
        <Cloud className="drift absolute left-4 top-10 w-32" />
        <Cloud className="drift-slow absolute right-6 top-[38%] w-24 opacity-90" />
        <div class="absolute inset-x-0 bottom-0 h-1/4 rounded-t-[3rem] bg-meadow"></div>
        <Owl stetho className="absolute bottom-4 left-1/2 w-[72%] -translate-x-1/2" />
      </div>
    </div>

    <!-- Copy -->
    <div>
      <h2 class="h-section">A pediatrician who is never too busy for you</h2>
      <p class="lede mt-5">
        Dr. Daniela Atanassova-Lineva cares for babies, kids and teens in Rego Park, Queens. She is board certified in
        pediatric and adolescent medicine and speaks five languages, so more families feel heard.
      </p>
      <p class="mt-4 max-w-[56ch]">
        Visits cover check-ups, walk-in care and long-term needs like asthma and allergies. Many tests happen right in
        the office, so you often leave with answers the same day.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2.5" aria-label="Highlights">
        {facts.map((f, i) => (
          <li class="tag" style={`--tag-shade:${['#f0c200', '#ff9d8e', '#7fcf9f', '#9bd3ee'][i]}`}>{f}</li>
        ))}
      </ul>

      <h3 class="mt-8 font-display text-xl">Tests we do in the office</h3>
      <p class="mt-2 max-w-[56ch] text-ink-soft">{tests.join(', ')}.</p>
      <p class="mt-4 max-w-[56ch] text-ink-soft">Affiliated with Mount Sinai, Northwell and NewYork-Presbyterian Queens.</p>

      <!-- Book -->
      <div class="sheet mt-9 flex max-w-xl items-center gap-5 p-5" style="--sheet:#ffd6cc;--sheet-shade:#f2a999;">
        <div class="relative z-[1] grid h-24 w-[4.5rem] shrink-0 -rotate-3 place-items-center rounded-md bg-coral p-2 text-center font-display text-[0.7rem] font-bold leading-tight shadow-[4px_4px_0_#d9503c]">
          Prescription for a Happy and Healthy Child
        </div>
        <div class="relative z-[1]">
          <h3 class="font-display text-xl">Dr. Daniela wrote a book for parents</h3>
          <a href="/book-by-dr-daniela" class="btn btn-paper mt-3 !px-4 !py-2.5 !text-base">Get the book</a>
        </div>
      </div>
    </div>
  </div>
</section>
