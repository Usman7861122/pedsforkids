---
import PaperEdge from '../ui/PaperEdge.astro';
import PromoVideo from '../ui/PromoVideo.astro';
import WatermarkLogo from '../ui/WatermarkLogo.astro';

const facts = ['Speaks five languages', 'Top Pediatrician of the Year 2022', 'Insured or self-pay', 'New patients welcome'];
const tests = ['Rapid strep and flu tests', 'Lung function tests', 'EKG', 'Blood work', 'Genetic testing'];
---
<section id="about" class="section-pad relative overflow-hidden bg-paper">
  <PaperEdge variant="cloud" class="text-paper" />
  <WatermarkLogo size="clamp(9rem,17vw,19rem)" class="absolute -right-[4%] top-1/2 hidden -translate-y-1/2 opacity-[0.12] mix-blend-multiply md:block" />
  <div class="container-x relative z-[2] grid items-stretch gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <!-- Intro video -->
    <PromoVideo src="/video/peds-for-you.mp4" poster="/video/peds-for-you-poster.jpg" label="Peds For Kids intro video" class="mx-auto aspect-[5/6] w-full max-w-xl" />

    <!-- Copy -->
    <div class="flex flex-col justify-between gap-8">
      <div>
      <h2 class="h-section">A pediatrician who is never too busy for you</h2>
      <p class="lede mt-5 max-w-[52ch]">
        Dr. Daniela Atanassova-Lineva cares for babies, kids and teens in Rego Park, Queens. She is board certified in
        pediatric and adolescent medicine and speaks five languages.
      </p>
      <p class="mt-4 max-w-[52ch]">
        Many tests happen right in the office, so you often leave with answers the same day.
      </p>

      </div>
      <div>
      <ul class="flex flex-wrap gap-2.5" aria-label="Highlights">
        {facts.map((f, i) => (
          <li class="tag" style={`--tag-shade:${['#f0c200', '#ff9d8e', '#7fcf9f', '#9bd3ee'][i]}`}>{f}</li>
        ))}
      </ul>

      <h3 class="mt-7 font-display text-xl">Tests we do in the office</h3>
      <p class="mt-2 max-w-[52ch] text-ink-soft">{tests.join(', ')}.</p>

      </div>
      <div><a href="/about" class="btn">More about us</a></div>
    </div>
  </div>
</section>
