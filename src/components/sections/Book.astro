---
import { Star } from '../art/Art';
import { book } from '../../data/book';
---
<section id="book" class="relative bg-grape-soft pb-20 md:pb-28">
  <!-- The waiting-room photo, shown clear and full width -->
  <div class="relative h-[56vw] max-h-[780px] min-h-[250px] w-full overflow-hidden">
    <img
      src="/images/hero-kids-reading.jpg"
      alt="Four children reading picture books together on a waiting-room bench at Peds For Kids"
      width="3498"
      height="1587"
      loading="lazy"
      class="size-full object-cover"
      style="object-position:58% 35%"
    />
    <Star className="bob absolute right-[5%] top-[10%] hidden w-10 md:block" color="#ffd23f" />
  </div>

  <!-- Book card that rests over the bottom of the photo -->
  <div class="container-x relative z-[2] -mt-16 md:-mt-36">
    <div class="sheet relative grid items-center gap-8 p-6 md:grid-cols-[minmax(0,17rem)_1fr] md:gap-14 md:p-10" style="--sheet:#fffdf7;--sheet-shade:#bda9ef;">
      <div class="relative mx-auto w-full max-w-[15rem] rotate-2 md:-mt-28 md:max-w-[17rem]">
        <span class="absolute -top-3 left-1/2 z-[2] h-6 w-24 -translate-x-1/2 -rotate-3 opacity-85" style="background:#43c37a" aria-hidden="true"></span>
        <a href={book.amazon} target="_blank" rel="noopener" class="block rounded-2xl bg-paper p-2.5 shadow-[0_9px_0_rgba(42,34,80,0.2)] transition-transform hover:-translate-y-1 hover:rotate-0">
          <img src={book.cover} alt={`Book cover: ${book.title}`} loading="lazy" class="block w-full rounded-xl" />
        </a>
      </div>
      <div class="relative z-[1]">
        <p class="font-display text-lg font-bold text-ink-soft">A book by Dr. Daniela</p>
        <h2 class="h-section mt-2">{book.title}</h2>
        <p class="mt-3 font-display text-xl font-bold">{book.sub}</p>
        <p class="lede mt-4 max-w-[52ch]">{book.text}</p>
        <p class="mt-3 text-sm text-ink-soft">By {book.authors}</p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a href={book.amazon} target="_blank" rel="noopener" class="btn btn-sun">Buy on Amazon</a>
          <img src={book.badge} alt="International Book Awards finalist" loading="lazy" class="h-20 w-20 object-contain" />
        </div>
      </div>
    </div>
  </div>
</section>
