---
// A torn / scalloped paper edge that sits on top of a section.
// Give it the same text color as the section background (e.g. class="text-sun-soft").
interface Props {
  variant?: 'scallop' | 'wave' | 'zigzag' | 'cloud';
  class?: string;
}
const { variant = 'scallop', class: cls = '' } = Astro.props;
const shapes = {
  scallop: { w: 56, d: 'M0 28V18C0 8 12 0 28 0s28 8 28 18V28Z' },
  wave: { w: 120, d: 'M0 28V16C20 -2 40 -2 60 14S100 30 120 16V28Z' },
  zigzag: { w: 40, d: 'M0 28V14L20 0l20 14V28Z' },
  cloud: { w: 140, d: 'M0 28V22A16 16 0 0 1 20 8A22 22 0 0 1 62 4A18 18 0 0 1 96 8A16 16 0 0 1 124 14A12 12 0 0 1 140 22V28Z' },
} as const;
const { w, d } = shapes[variant];
---
<svg
  class={`pointer-events-none absolute inset-x-0 top-0 z-[1] h-7 w-full -translate-y-[calc(100%-1px)] ${cls}`}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id={`pe-${variant}`} width={w} height="28" patternUnits="userSpaceOnUse">
      <path d={d} fill="currentColor" />
    </pattern>
  </defs>
  <rect width="100%" height="28" fill={`url(#pe-${variant})`} />
</svg>
