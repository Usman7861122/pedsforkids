---
// Shows a real photo in a paper frame when one is set in data/images.ts,
// otherwise renders the slot content (an illustration).
import { photos } from '../../data/images';

interface Props {
  slot: string;
  shape?: 'arch' | 'blob' | 'wobble' | 'round' | 'sheet';
  tape?: string; // tape color; omit for none
  class?: string;
  style?: string;
  pos?: string; // CSS object-position for the photo
}
const { slot, shape = 'sheet', tape, class: cls = '', style = '', pos = 'center 18%' } = Astro.props;
const photo = photos[slot];
const shapeClass = { arch: 'frame-arch', blob: 'frame-blob', wobble: 'frame-wobble', round: 'rounded-full', sheet: 'rounded-[1.5rem]' }[shape];
---
{photo?.src ? (
  <div class={`relative ${cls}`} style={style}>
    {tape && <span class="absolute -top-3 left-1/2 z-[2] h-6 w-20 -translate-x-1/2 -rotate-3 opacity-85" style={`background:${tape}`} aria-hidden="true"></span>}
    <div class={`h-full overflow-hidden bg-paper p-2 shadow-[0_7px_0_rgba(42,34,80,0.18)] ${shapeClass}`}>
      <img src={photo.src} alt={photo.alt} loading="lazy" class={`photo ${shapeClass}`} style={`object-position:${pos}`} />
    </div>
  </div>
) : (
  <slot />
)}
